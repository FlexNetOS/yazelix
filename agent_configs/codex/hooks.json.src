{
  "description": "FlexNetOS profile-owned RTK, ICM, and agent-guard lifecycle hooks. The guard runs on Codex's PreToolUse for parity with Claude: without it the identical destructive command was denied for Claude and allowed for Codex. Review command hooks through /hooks before enabling them.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/rtk hook codex"
          },
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook pre"
          },
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/agent guard"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook compact"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook end"
          }
        ]
      }
    ]
  }
}
