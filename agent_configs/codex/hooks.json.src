{
  "description": "FlexNetOS profile-owned RTK, ICM, and agent-guard lifecycle hooks. RTK and ICM inspect Bash; agent-guard receives every supported Codex PreToolUse event so shell, apply_patch, local-function, and MCP filesystem writes share one path law. Review command hooks through /hooks before enabling them.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/rtk hook codex"
          },
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook pre"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/agent guard"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook compact"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/flexnetos/.nix-profile/bin/icm hook end"
          }
        ]
      }
    ]
  }
}
