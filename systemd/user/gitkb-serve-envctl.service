[Unit]
Description=GitKB sync server for the envctl knowledge base
Documentation=https://github.com/gitkb/meta
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/flexnetos/meta/src/envctl
Environment=PATH=/home/flexnetos/.nix-profile/bin:/home/flexnetos/.nix-profile/toolbin:/usr/bin:/bin
ExecStart=/home/flexnetos/.nix-profile/bin/git-kb serve --host 127.0.0.1 --port 8479
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
